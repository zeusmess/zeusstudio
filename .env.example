# STARBUCKS CUP CATCHER — configuration
#
# Copy this file to .env.local (never commit it) and fill in the values from
# Firebase console → Project settings → Your apps → Web app → SDK setup.
#
# These are the PUBLIC web settings every Firebase web app ships to the browser.
# They are not secrets: access is enforced by the Realtime Database rules
# (database.rules.json) and the Authentication settings, not by hiding them.
# Never put a service account key or any other private credential here —
# everything prefixed VITE_ ends up in the browser bundle.
#
# Leave them empty to play without Firebase: single player, guest profiles and
# the device leaderboard work; Google sign-in, online matches and the global
# leaderboard show "awaiting configuration" instead of pretending to work.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
# Optional
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Use the local Firebase emulators instead of a real project (see .env.emulator
# and `npm run dev:emulators`). Host defaults to 127.0.0.1.
# VITE_USE_FIREBASE_EMULATORS=true
# VITE_FIREBASE_EMULATOR_HOST=127.0.0.1

# The Starbucks edition (name, logo and the drink photos supplied for this
# project) is built by default. Set to "off" for the brand-free edition:
# "Cup Catcher" with the game's original artwork only (README: Editions).
# VITE_BRAND_ASSETS=off
