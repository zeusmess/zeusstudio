# STARBUCKS CAREER — online settings
#
# Copy to .env.local (never commit it) and fill in from Firebase console →
# Project settings → Your apps → Web app. These are PUBLIC web settings, not
# secrets: access is enforced by database.rules.json. In GitHub Actions the same
# values come from the repository variables CAREER_FIREBASE_*.
#
# Leave them empty to play offline (progress stays on the device).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
# Optional: where players download the game (shown in the app's "share" box).
VITE_CAREER_WEB_URL=
VITE_CAREER_APK_URL=
