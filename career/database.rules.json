{
  "rules": {
    ".read": false,
    ".write": false,
    "career": {
      "admins": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      },
      "config": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('career/admins/' + auth.uid).val() === true",
        "announcement": {
          "text": { ".validate": "newData.isString() && newData.val().length <= 500" },
          "level": { ".validate": "newData.isString() && newData.val().matches(/^(info|success|warning|danger)$/)" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "maintenance": { ".validate": "newData.isBoolean()" },
        "maintenanceText": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "minVersion": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]+\\.[0-9]+\\.[0-9]+$/)" },
        "latestVersion": { ".validate": "newData.isString() && newData.val().matches(/^[0-9]+\\.[0-9]+\\.[0-9]+$/)" },
        "apkUrl": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "webUrl": { ".validate": "newData.isString() && newData.val().length <= 300" },
        "rewardMultiplier": { ".validate": "newData.isNumber() && newData.val() >= 0.5 && newData.val() <= 3" },
        "eventTitle": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "registrationOpen": { ".validate": "newData.isBoolean()" },
        "incidentRate": { ".validate": "newData.isNumber() && newData.val() >= 0.25 && newData.val() <= 4" },
        "updatedAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      },
      "moderation": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && root.child('career/admins/' + auth.uid).val() === true",
          "hidden": { ".validate": "newData.isBoolean()" },
          "banned": { ".validate": "newData.isBoolean()" },
          "note": { ".validate": "newData.isString() && newData.val().length <= 200" },
          "updatedAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },
      "players": {
        ".read": "auth != null",
        ".indexOn": ["missionsDone", "lastSeen", "joinedAt", "xp"],
        "$uid": {
          ".write": "auth != null && ((auth.uid === $uid && root.child('career/moderation/' + auth.uid + '/banned').val() !== true) || root.child('career/admins/' + auth.uid).val() === true)",
          ".validate": "newData.hasChildren(['name', 'title', 'provider', 'joinedAt', 'lastSeen', 'missionsDone', 'updatedAt'])",
          "name": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 60" },
          "title": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40" },
          "store": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "provider": { ".validate": "newData.isString() && newData.val().matches(/^(google|employee)$/)" },
          "photo": { ".validate": "newData.isString() && newData.val().length <= 400" },
          "joinedAt": { ".validate": "newData.isNumber() && (data.exists() ? newData.val() === data.val() : newData.val() === now)" },
          "lastSeen": { ".validate": "newData.isNumber() && newData.val() === now" },
          "updatedAt": { ".validate": "newData.isNumber() && newData.val() === now" },
          "missionsDone": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000 && newData.val() % 1 === 0 && (root.child('career/admins/' + auth.uid).val() === true || (data.exists() ? (newData.val() >= data.val() && newData.val() - data.val() <= (now - data.parent().child('updatedAt').val()) / 20000) : newData.val() === 0))" },
          "xp": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000000" },
          "rank": { ".validate": "newData.isString() && newData.val().matches(/^(barista|trainer|supervisor|asm|manager|area)$/)" },
          "chapter": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10" },
          "hof": { ".validate": "newData.isBoolean()" },
          "appVersion": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "$other": { ".validate": false }
        }
      },
      "private": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('career/admins/' + auth.uid).val() === true)",
          ".write": "auth != null && (auth.uid === $uid || root.child('career/admins/' + auth.uid).val() === true)",
          ".validate": "newData.hasChildren(['fullName', 'jobTitle', 'provider', 'createdAt'])",
          "fullName": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 60" },
          "employeeId": { ".validate": "newData.isString() && newData.val().matches(/^[A-Z0-9]{3,12}$/)" },
          "jobTitle": { ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 40" },
          "store": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "email": { ".validate": "newData.isString() && newData.val().length <= 160" },
          "provider": { ".validate": "newData.isString() && newData.val().matches(/^(google|employee)$/)" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "consentAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },
      "employeeIds": {
        "$employeeId": {
          ".read": "auth != null && (data.val() === auth.uid || root.child('career/admins/' + auth.uid).val() === true)",
          ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid && root.child('career/config/registrationOpen').val() !== false) || (data.val() === auth.uid && (!newData.exists() || newData.val() === auth.uid)) || root.child('career/admins/' + auth.uid).val() === true)",
          ".validate": "newData.isString() && newData.val().length <= 128 && $employeeId.matches(/^[A-Z0-9]{3,12}$/)"
        }
      },
      "saves": {
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('career/admins/' + auth.uid).val() === true)",
          ".write": "auth != null && ((auth.uid === $uid && root.child('career/moderation/' + auth.uid + '/banned').val() !== true) || root.child('career/admins/' + auth.uid).val() === true)",
          ".validate": "newData.hasChildren(['v', 'savedAt', 'data'])",
          "v": { ".validate": "newData.isNumber()" },
          "savedAt": { ".validate": "newData.isNumber()" },
          "data": { ".validate": "newData.isString() && newData.val().length <= 4000000" },
          "appVersion": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "missionsDone": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      },
      "daily": {
        "$date": {
          ".read": "auth != null",
          ".indexOn": ["missions"],
          "$uid": {
            ".write": "auth != null && $date.matches(/^20[0-9]{2}-[0-9]{2}-[0-9]{2}$/) && ((auth.uid === $uid && root.child('career/moderation/' + auth.uid + '/banned').val() !== true) || root.child('career/admins/' + auth.uid).val() === true)",
            ".validate": "newData.hasChildren(['name', 'title', 'missions', 'updatedAt'])",
            "name": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 60" },
            "title": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "store": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "missions": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000 && newData.val() % 1 === 0 && (root.child('career/admins/' + auth.uid).val() === true || (data.exists() ? (newData.val() >= data.val() && newData.val() - data.val() <= (now - data.parent().child('updatedAt').val()) / 20000) : newData.val() <= 3))" },
            "xp": { ".validate": "newData.isNumber() && newData.val() >= 0" },
            "updatedAt": { ".validate": "newData.isNumber() && newData.val() === now" },
            "$other": { ".validate": false }
          }
        }
      },
      "hallOfFame": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && ((auth.uid === $uid && !data.exists() && root.child('career/moderation/' + auth.uid + '/banned').val() !== true && root.child('career/players/' + $uid + '/missionsDone').val() >= 1000) || root.child('career/admins/' + auth.uid).val() === true)",
          ".validate": "newData.hasChildren(['name', 'title', 'completedAt'])",
          "name": { ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 60" },
          "title": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "store": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "completedAt": { ".validate": "newData.isNumber() && (root.child('career/admins/' + auth.uid).val() === true || newData.val() === now)" },
          "$other": { ".validate": false }
        }
      },
      "adminLog": {
        ".read": "auth != null && root.child('career/admins/' + auth.uid).val() === true",
        ".indexOn": ["at"],
        "$entry": {
          ".write": "auth != null && root.child('career/admins/' + auth.uid).val() === true && !data.exists()",
          ".validate": "newData.hasChildren(['by', 'action', 'at'])",
          "by": { ".validate": "newData.isString() && newData.val() === auth.uid" },
          "action": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "target": { ".validate": "newData.isString() && newData.val().length <= 128" },
          "detail": { ".validate": "newData.isString() && newData.val().length <= 300" },
          "at": { ".validate": "newData.isNumber() && newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    }
  }
}
