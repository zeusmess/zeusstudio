{
  "name": "starbucks-cup-catcher",
  "private": true,
  "version": "1.0.0",
  "description": "STARBUCKS CUP CATCHER — a bilingual (Arabic / English), mobile-first arcade game by Youssef Ayman.",
  "author": "Youssef Ayman",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "vite --mode emulator",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint && node scripts/check-source-text.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "node scripts/emulators.mjs -- vitest run --config vitest.rules.config.ts",
    "test:e2e": "playwright test --project=mobile --project=desktop",
    "test:e2e:multiplayer": "node scripts/emulators.mjs -- playwright test --project=multiplayer",
    "emulators": "node scripts/emulators.mjs",
    "simulate": "tsx scripts/simulate-balance.ts",
    "assets:brand": "python3 scripts/process_brand_assets.py",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "rules:build": "tsx scripts/build-database-rules.ts",
    "assets:icons": "tsx scripts/build-icons.ts"
  },
  "dependencies": {
    "@fontsource-variable/cairo": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "firebase": "12.19.0",
    "phaser": "3.90.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "15.34.0",
    "jsdom": "^28.1.0",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
